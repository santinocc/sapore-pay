# Everything below has a working default in config.ts for local dev.
# Real values only matter for a real deployment (Railway).

# ENSv2 Sepolia — see contracts/subname-registrar/README.md and
# docs/engineering-log.md for how these were deployed and verified.
# Required for /ens/chef/claim and /ens/chef/records to actually write
# on-chain; without it, both report "not configured" rather than crashing.
# This is the SAME key contracts/subname-registrar/deploy/.env.example uses
# as ENS_OWNER_PRIVATE_KEY — it's the account SaporeChefRegistrar was
# deployed with as `backend` and the shared resolver's admin.
ENS_BACKEND_PRIVATE_KEY=

# SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# ENS_CHEF_REGISTRAR=0x45347E1a412a16f494d945Ed3402A773A07fc5D1
# ENS_SHARED_RESOLVER=0x0356d23bcfBe2Cb42508542c930C7A2cCa352858

# World ID — from the Developer Portal (developer.world.org), World ID
# Configuration tab. Without WORLD_APP_ID, /world/rp-context and
# /world/verify report "not configured" rather than crashing (see
# packages/world), and apps/web's World step stays simulated-only.
# WORLD_RP_ID and WORLD_RP_SIGNING_KEY are the RP's own id and private
# signing key — a *different* pair from the app id, shown on the same
# Configuration page. The signing key is a real secret: never commit it,
# never put it in apps/web's env, only here. See packages/world's doc
# comment for why there's no way around holding it (no cloud "sign for me"
# call exists in the actual SDK — confirmed by reading its source, not
# assumed).
WORLD_APP_ID=
WORLD_RP_ID=
WORLD_RP_SIGNING_KEY=
# WORLD_ACTION=chef-onboarding
