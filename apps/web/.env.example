# Where apps/service is reachable. createOnChainSubnameClaimer and
# createOnChainRecordWriter call this for the "Real (Sepolia)" demo mode —
# see App.tsx.
VITE_SERVICE_URL=http://localhost:4000

# From the Privy Dashboard (dashboard.privy.io) — create an app there first.
# Without it, WalletConnect reports "not configured" rather than crashing
# (see privyWallet.ts). Enable "Email" as a login method and embedded
# wallets for the app in the dashboard; the config in main.tsx assumes both.
VITE_PRIVY_APP_ID=

# Same Sepolia RPC apps/service uses (see its SEPOLIA_RPC_URL default).
# Without this, viem's own default for Sepolia (a different provider,
# thirdweb's) reads from a node that can briefly lag behind whichever node
# just confirmed a write from the backend — surfacing as a false
# "no resolver yet" right after a real claim. Same provider, same view.
VITE_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# ENSv2 UserRegistry holding sapore.eth's Chef subnames — see
# contracts/subname-registrar/deploy/01-deploy-user-registry.mjs and
# docs/engineering-log.md. writeChefRecords() calls this contract's own
# getResolver(label) directly to find a name's resolver; viem's built-in
# getEnsResolver() doesn't know about ENSv2 registries at all and always
# returns null for names here, regardless of RPC provider or timing.
VITE_ENS_REGISTRY=0x9a932e911c7FD7DfD54d1B11Ef4fE0c9aa46862d

# From the World Developer Portal (developer.world.org) — World ID
# Configuration tab. Without it the World step stays simulated-only and its
# Real toggle is hidden, rather than offering a mode that can only fail.
# The matching action (`chef-onboarding`) is registered on the same app; the
# service knows it as WORLD_ACTION.
VITE_WORLD_APP_ID=

# "orb" (default) or "device". Orb is what backs the product's "one human,
# one Chef account" claim — device credentials are per-device, not per-person.
# Only set this to "device" if the machine demoing has no Orb-verified World
# ID available, and know that it weakens the uniqueness guarantee.
VITE_WORLD_VERIFICATION_LEVEL=orb
