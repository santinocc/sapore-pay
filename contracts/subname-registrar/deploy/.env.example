# Reuse the same throwaway key that owns sapore.eth
# (from sapore/scripts/register-sepolia-ens/generate-key.mjs) — it must be
# the account that owns sapore.eth on the ETH Registry, since this script
# calls setSubregistry() on that name. It's also the shared resolver's admin
# (02's `admin` argument), which 03-authorize-chef.mjs signs with to delegate
# per-Chef write access.
ENS_OWNER_PRIVATE_KEY=

# 02-deploy-shared-resolver.mjs's printed output. Required by
# 03-authorize-chef.mjs only.
SHARED_RESOLVER=

# SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
