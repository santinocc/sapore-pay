# ── apps/service ──────────────────────────────────────────────────────────────
PORT=4000
# MongoDB database owned by the payments service (never Sapore's app database)
MONGODB_URI=mongodb://localhost:27017/sapore-pay
# API key the Sapore API presents when calling this service
SERVICE_API_KEY=
# Shared secret used to HMAC-sign webhooks sent back to the Sapore API
WEBHOOK_SECRET=
# Where webhooks go (Sapore API) — https://api.sapore.food/webhooks/pay in prod
WEBHOOK_URL=http://localhost:3001/webhooks/pay
# JWKS of the Sapore API, used to verify end-user access tokens (RS256)
SAPORE_JWKS_URL=http://localhost:3001/.well-known/jwks.json
SAPORE_JWT_ISSUER=sapore

# ── chain / providers (filled in during the hackathon; never commit values) ──
TEMPO_CHAIN_ID=42431
TEMPO_RPC_URL=https://rpc.moderato.tempo.xyz
TEMPO_FEE_PAYER_URL=https://sponsor.moderato.tempo.xyz
TEMPO_API_KEY=
ESCROW_ADDRESS=
TREASURY_ADDRESS=
PRIVY_APP_ID=
PRIVY_APP_SECRET=
BRIDGE_API_KEY=
WORLD_APP_ID=
WORLD_ACTION_CHEF_ONBOARDING=chef-onboarding
ENS_PARENT_NAME=sapore.eth
ENS_GATEWAY_SIGNER_KEY=
